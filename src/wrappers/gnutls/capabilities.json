{
  "runtime": {
    "grpc_addr": "127.0.0.1:15052",
    "tls_port": 15552,
    "compose_service": "gnutls",
    "unsupported_tls_fields": ["ca_file"],
    "local_cli": ["gnutls-cli", "gnutls-serv"]
  },
  "gnutls_priority_base": {
    "server:1.3": "NORMAL:-VERS-ALL:+VERS-TLS1.3",
    "server:1.2": "NORMAL:%COMPAT:-VERS-SSL3.0:-VERS-TLS1.0:-VERS-TLS1.1:-VERS-ALL:+VERS-TLS1.2",
    "client:1.3": "NORMAL:-VERS-ALL:+VERS-TLS1.3",
    "client:1.2": "NORMAL:-VERS-ALL:+VERS-TLS1.2"
  },
  "tls13": {
    "cipher_suite": {
      "aes-128-gcm": "+AES-128-GCM",
      "aes-128-ccm": "+AES-128-CCM",
      "aes-128-ccm-8": "+AES-128-CCM-8",
      "aes-256-gcm": "+AES-256-GCM",
      "chacha20-poly1305": "+CHACHA20-POLY1305"
    }
  },
  "tls12": {
    "cipher_suite": {
      "aes-128-gcm": "+ECDHE-RSA:+AES-128-GCM",
      "aes-256-gcm": "+ECDHE-RSA:+AES-256-GCM",
      "chacha20-poly1305": "+ECDHE-RSA:+CHACHA20-POLY1305",
      "ecdhe-rsa-aes-128-gcm-sha256": "+ECDHE-RSA:+AES-128-GCM",
      "ecdhe-rsa-aes-256-gcm-sha384": "+ECDHE-RSA:+AES-256-GCM",
      "ecdhe-rsa-chacha20-poly1305": "+ECDHE-RSA:+CHACHA20-POLY1305",
      "ecdhe-ecdsa-aes-128-gcm-sha256": "+ECDHE-ECDSA:+AES-128-GCM",
      "ecdhe-ecdsa-aes-256-gcm-sha384": "+ECDHE-ECDSA:+AES-256-GCM",
      "ecdhe-ecdsa-chacha20-poly1305": "+ECDHE-ECDSA:+CHACHA20-POLY1305",
      "dhe-rsa-aes-128-gcm-sha256": "+DHE-RSA:+AES-128-GCM",
      "dhe-rsa-aes-256-gcm-sha384": "+DHE-RSA:+AES-256-GCM",
      "rsa-aes-128-gcm-sha256": "+RSA:+AES-128-GCM",
      "rsa-aes-256-gcm-sha384": "+RSA:+AES-256-GCM"
    }
  },
  "supported_groups": {
    "x25519": "X25519",
    "x448": "X448",
    "secp-256r1": "SECP256R1",
    "secp-384r1": "SECP384R1",
    "secp-521r1": "SECP521R1",
    "ffdhe-2048": "FFDHE2048",
    "ffdhe-3072": "FFDHE3072",
    "ffdhe-4096": "FFDHE4096"
  },
  "signature_schemes": {
    "rsa-pss-rsae-sha256": "SIGN-RSA-PSS-SHA256",
    "rsa-pss-rsae-sha384": "SIGN-RSA-PSS-SHA384",
    "rsa-pss-rsae-sha512": "SIGN-RSA-PSS-SHA512",
    "ecdsa-secp256r1-sha256": "SIGN-ECDSA-SECP256R1-SHA256",
    "ed25519": "SIGN-EdDSA-Ed25519",
    "ed448": "SIGN-EdDSA-Ed448"
  }
}
