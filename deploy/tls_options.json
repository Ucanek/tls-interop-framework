{
  "options": [
    {
      "id": "tls_version",
      "choices": ["1.2", "1.3"],
      "source": "TlsConfig.version",
      "description": "TLS version override for default scenario configs."
    },
    {
      "id": "cipher_suite",
      "choices": [
        "aes-256-gcm",
        "aes-128-gcm",
        "chacha20-poly1305"
      ],
      "source": "TlsConfig.cipher_suite",
      "description": "TLS 1.3 record cipher (same AEAD tokens as ticket_cipher); wrappers map to IANA / tool names (e.g. TLS_AES_256_GCM_SHA384)."
    },
    {
      "id": "tls_port",
      "source": "TlsConfig.port",
      "description": "TLS data-plane port override (default scenario value is 5555)."
    },
    {
      "id": "tls_hostname",
      "source": "TlsConfig.server_hostname",
      "description": "SNI / hostname override for default scenario configs."
    },
    {
      "id": "certificate_pem",
      "source": "TlsConfig.certificate",
      "description": "PEM certificate bytes provided to endpoint identity config."
    },
    {
      "id": "private_key_pem",
      "source": "TlsConfig.private_key",
      "description": "PEM private key bytes paired with certificate_pem."
    },
    {
      "id": "server_wrapper",
      "choices": ["openssl", "gnutls", "nss"],
      "source": "SERVER_WRAPPER",
      "description": "Server-side TLS implementation."
    },
    {
      "id": "client_wrapper",
      "choices": ["openssl", "gnutls", "nss"],
      "source": "CLIENT_WRAPPER",
      "description": "Client-side TLS implementation."
    },
    {
      "id": "supported_groups",
      "choices": [
        "x25519",
        "x448",
        "secp-256r1",
        "secp-384r1",
        "secp-521r1",
        "ffdhe-2048",
        "ffdhe-3072",
        "ffdhe-4096"
      ],
      "source": "TlsConfig.supported_groups + wrapper mapping",
      "description": "Advertised/allowed key exchange groups (supported_groups extension)."
    },
    {
      "id": "signature_schemes",
      "choices": [
        "rsa-pss-rsae-sha256",
        "rsa-pss-rsae-sha384",
        "rsa-pss-rsae-sha512",
        "ecdsa-secp256r1-sha256",
        "ed25519",
        "ed448"
      ],
      "source": "TlsConfig.signature_schemes + wrapper mapping",
      "description": "Advertised TLS signature algorithms."
    },
    {
      "id": "signature_schemes_cert",
      "choices": [
        "rsa-pss-rsae-sha256",
        "rsa-pss-rsae-sha384",
        "rsa-pss-rsae-sha512",
        "ecdsa-secp256r1-sha256",
        "ed25519",
        "ed448"
      ],
      "source": "TlsConfig.signature_schemes_cert + wrapper mapping",
      "description": "Signature algorithms accepted specifically for certificate path validation."
    },
    {
      "id": "alpn_protocols",
      "source": "TlsConfig.alpn_protocols + wrapper mapping",
      "description": "Application protocols for ALPN negotiation (e.g. h2, http/1.1)."
    },
    {
      "id": "supported_versions",
      "choices": ["1.2", "1.3"],
      "source": "TlsConfig.supported_versions + wrapper mapping",
      "description": "Explicit SupportedVersions extension values, ordered by preference."
    },
    {
      "id": "min_tls_version",
      "choices": ["1.2", "1.3"],
      "source": "TlsConfig.min_version + wrapper mapping",
      "description": "Lower bound for protocol version negotiation."
    },
    {
      "id": "max_tls_version",
      "choices": ["1.2", "1.3"],
      "source": "TlsConfig.max_version + wrapper mapping",
      "description": "Upper bound for protocol version negotiation."
    },
    {
      "id": "psk_modes",
      "choices": [
        "psk-dhe-ke",
        "psk-ke"
      ],
      "source": "TlsConfig.psk_modes",
      "description": "TLS 1.3 PSK key exchange modes."
    },
    {
      "id": "ticket_cipher",
      "choices": [
        "aes-256-gcm",
        "aes-128-gcm",
        "chacha20-poly1305"
      ],
      "source": "TlsConfig.ticket_cipher",
      "description": "Session ticket protection AEAD (same token set as cipher_suite)."
    },
    {
      "id": "ticket_lifetime",
      "source": "TlsConfig.ticket_lifetime",
      "description": "Session ticket key lifetime in seconds."
    },
    {
      "id": "max_early_data",
      "source": "TlsConfig.max_early_data",
      "description": "Maximum accepted 0-RTT early data bytes."
    },
    {
      "id": "enable_early_data",
      "choices": ["true", "false"],
      "source": "TlsConfig.enable_early_data",
      "description": "Allow or disable TLS 1.3 early data (0-RTT)."
    },
    {
      "id": "prefer_server_ciphers",
      "choices": ["true", "false"],
      "source": "TlsConfig.prefer_server_ciphers",
      "description": "Whether server preference overrides client cipher order."
    },
    {
      "id": "use_encrypt_then_mac",
      "source": "TlsConfig.use_encrypt_then_mac",
      "description": "Toggle Encrypt-then-MAC extension behavior."
    },
    {
      "id": "use_extended_master_secret",
      "source": "TlsConfig.use_extended_master_secret",
      "description": "Toggle Extended Master Secret support."
    },
    {
      "id": "require_extended_master_secret",
      "source": "TlsConfig.require_extended_master_secret",
      "description": "Require EMS negotiation for successful handshake."
    },
    {
      "id": "record_size_limit",
      "source": "TlsConfig.record_size_limit",
      "description": "Advertised record_size_limit extension value."
    },
    {
      "id": "max_fragment_length",
      "choices": ["512", "1024", "2048", "4096"],
      "source": "TlsConfig.max_fragment_length",
      "description": "Advertised max_fragment_length extension value."
    },
    {
      "id": "session_tickets_enabled",
      "choices": ["true", "false"],
      "source": "TlsConfig.session_tickets_enabled",
      "description": "Enable or disable issuance/acceptance of session tickets."
    },
    {
      "id": "ocsp_stapling",
      "choices": ["true", "false"],
      "source": "TlsConfig.ocsp_stapling",
      "description": "Enable OCSP status_request handling and stapling behavior."
    },
    {
      "id": "renegotiation",
      "choices": ["disabled", "safe", "unsafe"],
      "source": "TlsConfig.renegotiation",
      "description": "Control TLS renegotiation policy for legacy scenarios."
    },
    {
      "id": "post_handshake_auth",
      "choices": ["true", "false"],
      "source": "TlsConfig.post_handshake_auth",
      "description": "Allow post-handshake client authentication (TLS 1.3)."
    },
    {
      "id": "verify_peer",
      "choices": ["required", "optional", "none"],
      "source": "TlsConfig.verify_peer",
      "description": "Peer certificate verification policy."
    },
    {
      "id": "verify_hostname",
      "choices": ["true", "false"],
      "source": "TlsConfig.verify_hostname",
      "description": "Enable endpoint identity verification against tls_hostname."
    },
    {
      "id": "ca_file",
      "source": "TlsConfig.ca_file",
      "description": "Path/identifier for trusted CA bundle file."
    },
    {
      "id": "ca_path",
      "source": "TlsConfig.ca_path",
      "description": "Path/identifier for trusted CA directory."
    },
    {
      "id": "keylog_file",
      "source": "TlsConfig.keylog_file",
      "description": "NSS/SSLKEYLOGFILE-compatible key log output path."
    },
    {
      "id": "certificate_compression_send",
      "choices": ["zlib", "brotli", "zstd"],
      "source": "TlsConfig.certificate_compression_send",
      "description": "Allowed algorithms for certificate compression when sending."
    },
    {
      "id": "certificate_compression_receive",
      "choices": ["zlib", "brotli", "zstd"],
      "source": "TlsConfig.certificate_compression_receive",
      "description": "Allowed algorithms for certificate compression when receiving."
    }
  ]
}
